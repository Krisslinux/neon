<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="13dp">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦ NEON HUB" android:textStyle="bold" android:textSize="15sp" android:textColor="#C6FF00" android:paddingBottom="8dp"/>
  <LinearLayout android:id="@+id/ai_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/chatgpt" style="@style/Tile" android:text="GPT"/>
    <TextView android:id="@+id/gemini" style="@style/Tile" android:text="Gemini"/>
    <TextView android:id="@+id/grok" style="@style/Tile" android:text="Grok"/>
    <TextView android:id="@+id/perplexity" style="@style/Tile" android:text="Pplx"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/status_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
    <TextView android:id="@+id/battery" style="@style/StatusTile" android:text="BATTERY"/>
    <TextView android:id="@+id/bluetooth" style="@style/StatusTile" android:text="BLUETOOTH"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/music_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp">
    <TextView android:id="@+id/song" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="♫ Music"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
      <TextView android:id="@+id/prev" style="@style/MusicButton" android:text="❮❮"/>
      <TextView android:id="@+id/play" style="@style/MusicButton" android:text="▶ / Ⅱ" android:textColor="#C6FF00"/>
      <TextView android:id="@+id/next" style="@style/MusicButton" android:text="❯❯"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>